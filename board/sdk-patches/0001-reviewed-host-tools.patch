+set -eu
+
+# Keep the vendor's seven positional records. Missing optional images use zero;
+# unreadable files and ambiguous wildcard matches must stop packaging.
+append_optional() {
+    if [ "$#" -ne 1 ]; then
+        echo "CRC image pattern matched more than one file" >&2
+        return 1
+    fi
+    if [ -e "$1" ] || [ -L "$1" ]; then
+        ./crc32app "$1"
+    else
+        printf '\000\000\000\000' >> crcdata.bin
+    fi
+}
+
+: > crcdata.bin
+append_optional u-boot.img
+append_optional *.dtb
+append_optional zImage
+append_optional rootfs*
+append_optional bootanimation
+append_optional ubootspl.bin
+append_optional bootlogo
