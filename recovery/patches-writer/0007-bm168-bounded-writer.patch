+/*
+ * Raw data input for an authorized program sequence only: whole main area or
+ * whole spare area, 32-bit writes to the data register (the path R7's raw
+ * reads use). Anything else marks the sequence faulty so PAGEPROG is skipped.
+ */
 static void ark_nfc_write_buf(struct mtd_info *mtd, const uint8_t *buf, int len)
 {
-	pr_err_ratelimited("AUTOTOP read-only NAND: data write blocked\n");
+	struct nand_chip *chip = mtd_to_nand(mtd);
+	struct ark_nfc *nfc = to_ark_nfc(chip);
+	union {
+		u32 word;
+		u8 byte[4];
+	} tmp;
+	int i;
+
+	if (!nfc->writer_cmd || (len != mtd->writesize && len != mtd->oobsize)) {
+		nfc->writer_fault = true;
+		pr_err_ratelimited("AUTOTOP NAND: data write blocked (len %d)\n", len);
+		return;
+	}
+	for (i = 0; i < len; i += 4) {
+		memcpy(tmp.byte, buf + i, 4);
+		writel(tmp.word, nfc->regs + rNAND_DATA);
+	}
+}
+
+static bool ark_writer_allowed(struct ark_nfc *nfc, u64 addr, u64 len,
+			       const char *op)
+{
+	if (nfc->window_present && READ_ONCE(nfc->armed) &&
+	    bm168_window_contains(nfc->window_start, nfc->window_size, addr, len))
+		return true;
+	nfc->rejects++;
+	dev_err(nfc->dev, "AUTOTOP writer rejected %s at 0x%llx+0x%llx (armed=%d)\n",
+		op, addr, len, READ_ONCE(nfc->armed));
+	return false;
+}
+
+/* Bounded ready wait, then require ready, not write-protected and no failure. */
+static int ark_writer_wait(struct mtd_info *mtd, struct nand_chip *chip,
+			   unsigned int timeout_us)
+{
+	unsigned int waited = 0;
+	u8 status;
+
+	ndelay(100);	/* tWB */
+	while (!chip->dev_ready(mtd)) {
+		if (waited >= timeout_us)
+			return -ETIMEDOUT;
+		udelay(5);
+		waited += 5;
+	}
+	nand_status_op(chip, &status);
+	if (!(status & NAND_STATUS_READY))
+		return -ETIMEDOUT;
+	if (!(status & NAND_STATUS_WP))
+		return -EROFS;
+	if (status & NAND_STATUS_FAIL)
+		return -EIO;
+	return 0;
+}
+
+static void ark_writer_begin(struct ark_nfc *nfc)
+{
+	/* Raw data path: the BCH engine must not process or append anything. */
+	writel(readl(nfc->regs + rBCH_CR) &
+	       ~(BCH_CR_BCH_ENABLE | BCH_CR_SOFT_ECC_ENABLE), nfc->regs + rBCH_CR);
+	nfc->writer_fault = false;
+	nfc->writer_cmd = true;
+}
+
+static int ark_writer_write_page_raw(struct mtd_info *mtd, struct nand_chip *chip,
+				     const uint8_t *buf, int oob_required, int page)
+{
+	struct ark_nfc *nfc = to_ark_nfc(chip);
+	u64 addr = (u64)page << chip->page_shift;
+	int ret;
+
+	if (!ark_writer_allowed(nfc, addr, mtd->writesize, "program"))
+		return -EPERM;
+	/* Only complete stock-format pages: reserved/free OOB 0xff, parity exact. */
+	if (!oob_required || bm168_check_page(buf, chip->oob_poi)) {
+		nfc->rejects++;
+		dev_err(nfc->dev, "AUTOTOP writer rejected non-stock page at 0x%llx\n", addr);
+		return -EINVAL;
+	}
+	ark_writer_begin(nfc);
+	chip->cmdfunc(mtd, NAND_CMD_SEQIN, 0x00, page);
+	chip->write_buf(mtd, buf, mtd->writesize);
+	chip->write_buf(mtd, chip->oob_poi, mtd->oobsize);
+	if (nfc->writer_fault) {
+		nfc->writer_cmd = false;
+		chip->cmdfunc(mtd, NAND_CMD_RESET, -1, -1);	/* abandon data input */
+		nfc->rejects++;
+		return -EIO;
+	}
+	chip->cmdfunc(mtd, NAND_CMD_PAGEPROG, -1, -1);
+	nfc->writer_cmd = false;
+	ret = ark_writer_wait(mtd, chip, ARK_WRITER_PROG_TIMEOUT_US);
+	if (ret) {
+		dev_err(nfc->dev, "AUTOTOP writer program failed at 0x%llx: %d\n", addr, ret);
+		return ret;
+	}
+	nfc->programs++;
+	return 0;
 }
 
+static int ark_writer_erase(struct mtd_info *mtd, int page)
+{
+	struct nand_chip *chip = mtd_to_nand(mtd);
+	struct ark_nfc *nfc = to_ark_nfc(chip);
+	u64 addr = (u64)page << chip->page_shift;
+	int ret;
+
+	if ((addr & (mtd->erasesize - 1)) ||
+	    !ark_writer_allowed(nfc, addr, mtd->erasesize, "erase"))
+		return -EPERM;
+	ark_writer_begin(nfc);
+	chip->cmdfunc(mtd, NAND_CMD_ERASE1, -1, page);
+	chip->cmdfunc(mtd, NAND_CMD_ERASE2, -1, -1);
+	nfc->writer_cmd = false;
+	ret = ark_writer_wait(mtd, chip, ARK_WRITER_ERASE_TIMEOUT_US);
+	if (ret) {
+		dev_err(nfc->dev, "AUTOTOP writer erase failed at 0x%llx: %d\n", addr, ret);
+		return ret;
+	}
+	nfc->erases++;
+	dev_info(nfc->dev, "AUTOTOP writer erased 0x%llx\n", addr);
+	return 0;
+}
+
+static int ark_writer_refuse_oob(struct mtd_info *mtd, struct nand_chip *chip, int page)
+{
+	return -EROFS;
+}
+
+static int ark_writer_refuse_markbad(struct mtd_info *mtd, loff_t ofs)
