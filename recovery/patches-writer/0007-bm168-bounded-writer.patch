+}
+
+static ssize_t autotop_writer_show(struct device *dev, struct device_attribute *attr,
+				   char *buf)
+{
+	struct ark_nfc *nfc = dev_get_drvdata(dev);
+
+	return sprintf(buf, "window=0x%llx+0x%llx armed=%d erases=%lu programs=%lu rejects=%lu\n",
+		       nfc->window_start, nfc->window_size, READ_ONCE(nfc->armed),
+		       nfc->erases, nfc->programs, nfc->rejects);
+}
+
+/* "arm <start> <size>" must repeat the DT window exactly; "disarm" always works. */
+static ssize_t autotop_writer_store(struct device *dev, struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	struct ark_nfc *nfc = dev_get_drvdata(dev);
+	unsigned long long start, size;
+	char verb[8];
+
+	if (sscanf(buf, "%7s", verb) != 1)
+		return -EINVAL;
+	if (!strcmp(verb, "disarm")) {
+		WRITE_ONCE(nfc->armed, false);
+		dev_info(dev, "AUTOTOP writer disarmed\n");
+		return count;
+	}
+	if (strcmp(verb, "arm") || sscanf(buf, "%*s %llx %llx", &start, &size) != 2 ||
+	    start != nfc->window_start || size != nfc->window_size)
+		return -EINVAL;
+	WRITE_ONCE(nfc->armed, true);
+	dev_info(dev, "AUTOTOP writer ARMED for 0x%llx+0x%llx\n", start, size);
+	return count;
+}
+static DEVICE_ATTR_RW(autotop_writer);
