+/* AUTOTOP: PCM on ark-dma's cyclic API, as stock's ark_pcm_dma: a cyclic
+ * linked list over the ALSA buffer, one block interrupt per period, the
+ * position read back from the channel's memory-side address register. */
+struct ark_pcm_rtd {
+	struct dma_chan		*chan;
+	bool			prepared;
 };
 
+static void ark_pcm_period_done(void *param)
+{
+	snd_pcm_period_elapsed(param);
+}
+
+static int ark_pcm_open(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct ark_pcm_rtd *prtd;
+	int ret;
+
+	ret = snd_soc_set_runtime_hwparams(substream, &ark1668_pcm_hardware);
+	if (ret)
+		return ret;
+	ret = snd_pcm_hw_constraint_integer(substream->runtime, SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0)
+		return ret;
+	prtd = kzalloc(sizeof(*prtd), GFP_KERNEL);
+	if (!prtd)
+		return -ENOMEM;
+	prtd->chan = dma_request_slave_channel(rtd->cpu_dai->dev,
+			substream->stream == SNDRV_PCM_STREAM_PLAYBACK ? "tx" : "rx");
+	if (!prtd->chan) {
+		dev_err(rtd->cpu_dai->dev, "no DMA channel\n");
+		kfree(prtd);
+		return -EBUSY;
+	}
+	substream->runtime->private_data = prtd;
+	return 0;
+}
+
+static void ark_pcm_unprepare(struct ark_pcm_rtd *prtd)
+{
+	if (prtd->prepared) {
+		dw_dma_cyclic_free(prtd->chan);
+		prtd->prepared = false;
+	}
+}
+
+static int ark_pcm_close(struct snd_pcm_substream *substream)
+{
+	struct ark_pcm_rtd *prtd = substream->runtime->private_data;
+
+	ark_pcm_unprepare(prtd);
+	dma_release_channel(prtd->chan);
+	kfree(prtd);
+	return 0;
+}
+
+static int ark_pcm_hw_params(struct snd_pcm_substream *substream,
+			     struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct ark_i2s_dev *i2s = snd_soc_dai_get_drvdata(rtd->cpu_dai);
+	struct ark_pcm_rtd *prtd = substream->runtime->private_data;
+	struct dma_slave_config cfg = { 0 };
+	int ret;
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		cfg.direction = DMA_MEM_TO_DEV;
+		cfg.dst_addr = i2s->playback_dma_data.addr;
+		cfg.dst_addr_width = i2s->playback_dma_data.addr_width;
+		cfg.dst_maxburst = i2s->playback_dma_data.maxburst;
+		/* Stock bursts 16 words on the memory side too (CTL 0x1890d925). */
+		cfg.src_addr_width = cfg.dst_addr_width;
+		cfg.src_maxburst = cfg.dst_maxburst;
+	} else {
+		cfg.direction = DMA_DEV_TO_MEM;
+		cfg.src_addr = i2s->capture_dma_data.addr;
+		cfg.src_addr_width = i2s->capture_dma_data.addr_width;
+		cfg.src_maxburst = i2s->capture_dma_data.maxburst;
+		/* Stock: memory side also 16-word bursts (CTL 0x18a0dc25). */
+		cfg.dst_addr_width = cfg.src_addr_width;
+		cfg.dst_maxburst = cfg.src_maxburst;
+	}
+	ret = dmaengine_slave_config(prtd->chan, &cfg);
+	if (ret)
+		return ret;
+	return snd_pcm_lib_malloc_pages(substream, params_buffer_bytes(params));
+}
+
+static int ark_pcm_hw_free(struct snd_pcm_substream *substream)
+{
+	ark_pcm_unprepare(substream->runtime->private_data);
+	return snd_pcm_lib_free_pages(substream);
+}
+
+static int ark_pcm_prepare(struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct ark_pcm_rtd *prtd = runtime->private_data;
+	struct dw_cyclic_desc *cdesc;
+
+	/* A fresh list on every prepare (also after stop/start cycles). */
+	ark_pcm_unprepare(prtd);
+	cdesc = dw_dma_cyclic_prep(prtd->chan, runtime->dma_addr,
+			snd_pcm_lib_buffer_bytes(substream),
+			snd_pcm_lib_period_bytes(substream),
+			substream->stream == SNDRV_PCM_STREAM_PLAYBACK ?
+				DMA_MEM_TO_DEV : DMA_DEV_TO_MEM);
+	if (IS_ERR(cdesc))
+		return PTR_ERR(cdesc);
+	cdesc->period_callback = ark_pcm_period_done;
+	cdesc->period_callback_param = substream;
+	prtd->prepared = true;
+	return 0;
+}
+
+static int ark_pcm_trigger(struct snd_pcm_substream *substream, int cmd)
+{
+	struct ark_pcm_rtd *prtd = substream->runtime->private_data;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		return dw_dma_cyclic_start(prtd->chan);
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		dw_dma_cyclic_stop(prtd->chan);
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static snd_pcm_uframes_t ark_pcm_pointer(struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct ark_pcm_rtd *prtd = runtime->private_data;
+	dma_addr_t pos = substream->stream == SNDRV_PCM_STREAM_PLAYBACK ?
+		dw_dma_get_src_addr(prtd->chan) : dw_dma_get_dst_addr(prtd->chan);
+	snd_pcm_uframes_t x;
+
+	if (pos < runtime->dma_addr)
+		return 0;
+	x = bytes_to_frames(runtime, pos - runtime->dma_addr);
+	return x >= runtime->buffer_size ? 0 : x;
+}
+
+static int ark_pcm_new(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_card *card = rtd->card->snd_card;
+	int ret = dma_coerce_mask_and_coherent(card->dev, DMA_BIT_MASK(32));
+
+	if (ret)
+		return ret;
+	return snd_pcm_lib_preallocate_pages_for_all(rtd->pcm, SNDRV_DMA_TYPE_DEV,
+			card->dev, ark1668_pcm_hardware.buffer_bytes_max,
+			ark1668_pcm_hardware.buffer_bytes_max);
