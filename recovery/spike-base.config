
# Plan A spike on the SDK's ark1668_defconfig (the configuration galcore.ko
# was built against). Only boot-mechanics and safety additions here; every
# other option keeps the SDK value, checked by tools/recovery.py.
CONFIG_BLK_DEV_INITRD=y
CONFIG_ARM_APPENDED_DTB=y
# CONFIG_ARM_ATAG_DTB_COMPAT is not set
CONFIG_CMDLINE="console=ttyS0,115200n8 earlyprintk mem=64M rdinit=/init clk_ignore_unused panic=0"
# Without ATAGS (SDK) the command line comes from the DT chosen node.
CONFIG_DEVTMPFS=y
# CONFIG_MTD_UBI is not set
# CONFIG_MTD_BLOCK is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_LOGO is not set
# zImage wrapper compression only (no ABI effect): gzip as in the recovery images.
# CONFIG_KERNEL_LZO is not set
CONFIG_KERNEL_GZIP=y
