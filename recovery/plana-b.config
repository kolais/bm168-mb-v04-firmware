# Plan A option B on top of spike.config. zImage compression only (no ABI
# effect): XZ makes the kernel without initramfs ~2.65 MB, under stock
# U-Boot's fixed kernel_size 0x32fed8 (gzip: ~3.5 MB).
# CONFIG_KERNEL_GZIP is not set
CONFIG_KERNEL_XZ=y
# Root from the read-only NAND: UBI (attaches read-only on read-only MTD)
# and ubiblock for the squashfs volume.
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_BLOCK=y
# CONFIG_MTD_UBI_FASTMAP is not set
# CONFIG_MTD_UBI_GLUEBI is not set
