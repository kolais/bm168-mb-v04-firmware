
# Wi-Fi RAM probe (Plan A): networking, cfg80211, DesignWare SDIO host and
# loadable modules for the RTL8821CS driver. NAND stays read-only (storage
# profile and patches unchanged); no SD block devices, no wireless extensions.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_FORCE_LOAD is not set
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
# CONFIG_IPV6 is not set
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
# CONFIG_CFG80211_WEXT is not set
# CONFIG_MAC80211 is not set
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
# CONFIG_MMC_BLOCK is not set
