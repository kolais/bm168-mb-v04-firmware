
# Plan A GPU/display spike additions on top of ark1668_defconfig (see
# spike-base.config). The LCD driver stays built in as in the SDK; the clock
# cannot change because the DT clock node has no index/div values.
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
# CONFIG_DYNAMIC_DEBUG is not set
# Decoder driver as a module: a probe failure then cannot stop the boot.
CONFIG_ARK_HX170DEC=m
# Peripheral stage: Goodix GT911 touch on I2C bus 0 (stock Goodix-TS), as a
# module: built in, its interrupt hung SPIKE9's boot (the Ark GPIO controller
# is level-only); it is loaded by hand, last, once polling has been checked.
CONFIG_TOUCHSCREEN_GOODIX=m
# Wi-Fi throughput: stock moves SDIO data by DMA (ark_dw_dmac); without the
# DMA driver dw_mmc falls back to PIO and loses received frames.
CONFIG_ARK_DMA=y
# ark-dma.c forks the generic DesignWare driver (same symbols): both built in
# fail to link; nothing on this board uses the generic one (downstream ee7d394).
# CONFIG_DW_DMAC is not set
# Audio (SPIKE14): stock's card from the SDK drivers, all as modules so a
# probe failure cannot stop the boot; loaded by hand from USB.
CONFIG_SND_SOC_ARK=m
CONFIG_SND_SOC_ARK1668_I2S=m
CONFIG_SND_SOC_ARK1668_DAC=m
CONFIG_SND_SOC_ARK1668_ADC=m
CONFIG_SND_SOC_BD37033=m
CONFIG_SND_SIMPLE_CARD=m
# The SDK's dummy card would take card 0; stock's ARK-SDDAC is card 0.
# CONFIG_SND_DUMMY is not set
# U DISK (MUSB host): stock uses the controller's own (Inventra) DMA; the
# SDK's PIO-only setting reset the stick mid-read under load (SPIKE16).
# CONFIG_MUSB_PIO_ONLY is not set
CONFIG_USB_INVENTRA_DMA=y
# Wireless CarPlay: stock's mdnsd (Bonjour, finds the phone) exits without
# AF_INET6, and CarPlay uses IPv6 link-local addresses; stock 3.4 has IPv6.
CONFIG_IPV6=y
# Launcher's brightness setting: stock's pwm-backlight sysfs path.
CONFIG_BACKLIGHT_PWM=y
# Kernel tick profiler (/proc/profile, boot option profile=2) for the CarPlay
# CPU investigation; perf is excluded by galcore's ABI options.
CONFIG_PROFILING=y
