@@ -375,8 +374,43 @@
 
 static int ark_musb_set_mode(struct musb *musb, u8 mode)
 {
-	/* This recovery image only consumes the host port prepared by U-Boot. */
-	return mode == MUSB_HOST ? 0 : -EOPNOTSUPP;
+	struct ark_glue *glue = dev_get_drvdata(musb->controller->parent);
+	void __iomem *reset;
+	u32 value;
+
+	if (mode != MUSB_HOST)
+		return -EOPNOTSUPP;
+	/* Only the measured U DISK port opts into this experiment. */
+	if (!of_property_read_bool(glue->dev->of_node, "autotop,stock-host-startup"))
+		return 0;
+	/* Core probe also calls set_mode; wait for the explicit init-script request. */
+	if (!musb->is_initialized)
+		return 0;
+	if (glue->host_started)
+		return 0;
+	if (glue->gpio_id != 1 || glue->gpio_pwr != 117 ||
+	    glue->usb_softrest_reg_offset != 0x78 ||
+	    glue->usb_softrest_bit_offset != 6)
+		return -EINVAL;
+
+	/* mode_store holds musb->lock with IRQs disabled: do not sleep here. */
+	gpio_set_value(glue->gpio_id, 0);
+	musb->xceiv->otg->state = OTG_STATE_A_HOST;
+	reset = glue->sys_base + glue->usb_softrest_reg_offset;
+	value = readl(reset);
+	writel(value & ~BIT(6), reset);
+	mdelay(1);
+	value = readl(reset);
+	writel(value | BIT(6), reset);
+	mdelay(50);
+	musb_writeb(musb->mregs, MUSB_INTRUSBE, 0xf4);
+	musb_writeb(musb->mregs, MUSB_DEVCTL, 0x99);
+	gpio_set_value(glue->gpio_pwr, 0);
+	mdelay(200);
+	gpio_set_value(glue->gpio_pwr, 1);
+	glue->host_started = true;
+	dev_info(glue->dev, "BM168 U DISK stock host startup completed\n");
+	return 0;
 }
 
