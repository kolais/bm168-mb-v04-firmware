set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_C_COMPILER /work/toolchain/bin/arm-buildroot-linux-musleabihf-gcc)
set(CMAKE_CXX_COMPILER /work/toolchain/bin/arm-buildroot-linux-musleabihf-g++)
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a5 -mfpu=vfpv3-d16 -mfloat-abi=hard -ffunction-sections -fdata-sections")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static -Wl,--gc-sections")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
